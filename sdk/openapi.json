{
  "openapi": "3.1.0",
  "info": {
    "title": "FIMBox HAND-FIM API",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/config": {
      "get": {
        "tags": [
          "authentication"
        ],
        "summary": "Authentication Config",
        "description": "Discover whether this server requires HydroShare authentication.",
        "operationId": "authentication_config_auth_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationConfig"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "tags": [
          "authentication"
        ],
        "summary": "Begin Oauth Login",
        "operationId": "begin_oauth_login_auth_login_get",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Scope"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "tags": [
          "authentication"
        ],
        "summary": "Complete Oauth Login",
        "operationId": "complete_oauth_login_auth_callback_get",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          },
          {
            "name": "fimbox_oauth_state",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fimbox Oauth State"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session JSON for manual login; HTML completion for SDK browser transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionToken"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/oauth/token": {
      "post": {
        "tags": [
          "authentication"
        ],
        "summary": "Oauth Token Exchange",
        "operationId": "oauth_token_exchange_auth_oauth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_oauth_token_exchange_auth_oauth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionToken"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": [
          "authentication"
        ],
        "summary": "Current Session",
        "operationId": "current_session_auth_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Current Session Auth Session Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          },
          {}
        ],
        "description": "Authentication is required only when the server has OAuth credentials configured. See GET /auth/config."
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "authentication"
        ],
        "summary": "Logout",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/hand-fim": {
      "post": {
        "summary": "Submit Hand Fim",
        "description": "Submit a HAND-FIM job with scenarios and options in the JSON body.\nAuthentication is required only when the server has OAuth credentials configured. See GET /auth/config.",
        "operationId": "submit_hand_fim_jobs_hand_fim_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HandFimJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSubmitted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          },
          {}
        ]
      }
    },
    "/jobs": {
      "get": {
        "summary": "List Jobs",
        "operationId": "list_jobs_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          },
          {}
        ],
        "description": "Authentication is required only when the server has OAuth credentials configured. See GET /auth/config."
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "Get Job Status",
        "operationId": "get_job_status_jobs__job_id__get",
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Authentication is required only when the server has OAuth credentials configured. See GET /auth/config."
      },
      "delete": {
        "summary": "Cancel Job",
        "description": "Revoke queued jobs; the solo worker cannot interrupt a running subprocess.\nAuthentication is required only when the server has OAuth credentials configured. See GET /auth/config.",
        "operationId": "cancel_job_jobs__job_id__delete",
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/device/start": {
      "post": {
        "tags": [
          "authentication"
        ],
        "summary": "Begin Device Login",
        "operationId": "begin_device_login_auth_device_start_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceLoginStarted"
                }
              }
            }
          },
          "409": {
            "description": "Authentication disabled"
          },
          "429": {
            "description": "Login attempt rate exceeded; see Retry-After"
          },
          "503": {
            "description": "Login store unavailable"
          }
        }
      }
    },
    "/auth/device/poll": {
      "post": {
        "tags": [
          "authentication"
        ],
        "summary": "Poll Device Session",
        "operationId": "poll_device_session_auth_device_poll_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceLoginPoll"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction or retrieval secret"
          },
          "410": {
            "description": "Expired or consumed transaction/session"
          },
          "429": {
            "description": "Poll interval exceeded; see Retry-After"
          },
          "503": {
            "description": "Login store unavailable or transaction busy"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthenticationConfig": {
        "properties": {
          "authentication_enabled": {
            "type": "boolean",
            "title": "Authentication Enabled"
          }
        },
        "type": "object",
        "required": [
          "authentication_enabled"
        ],
        "title": "AuthenticationConfig"
      },
      "Body_oauth_token_exchange_auth_oauth_token_post": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code"
          },
          "code_verifier": {
            "type": "string",
            "maxLength": 128,
            "minLength": 43,
            "title": "Code Verifier"
          },
          "grant_type": {
            "type": "string",
            "title": "Grant Type",
            "default": "authorization_code"
          },
          "redirect_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redirect Uri"
          }
        },
        "type": "object",
        "required": [
          "code",
          "code_verifier"
        ],
        "title": "Body_oauth_token_exchange_auth_oauth_token_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandFimOutput": {
        "properties": {
          "ScenarioID": {
            "type": "string",
            "title": "Scenarioid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ScenarioID"
        ],
        "title": "HandFimOutput",
        "description": "Metadata for a single generated scenario output."
      },
      "HandFimParameters": {
        "items": {
          "$ref": "#/components/schemas/Scenario"
        },
        "type": "array",
        "minItems": 1,
        "title": "HandFimParameters",
        "description": "The shared scenario JSON schema with worker-specific validation."
      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "type": "array",
            "title": "Jobs"
          }
        },
        "type": "object",
        "required": [
          "jobs"
        ],
        "title": "JobList"
      },
      "JobStatus": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StoredHandFimResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobStatus"
      },
      "JobSubmitted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "status_url"
        ],
        "title": "JobSubmitted"
      },
      "JobSummary": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobSummary"
      },
      "OutputFile": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          }
        },
        "type": "object",
        "required": [
          "path",
          "size_bytes"
        ],
        "title": "OutputFile"
      },
      "Reach": {
        "properties": {
          "HUC": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "title": "Huc",
            "description": "Hydrologic Unit Code identifying the primary watershed corresponding to the input data. Used to locate the necessary input HAND and rating curve datasets.",
            "examples": [
              "03020201"
            ]
          },
          "ReachID": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "title": "Reachid",
            "description": "NWM identifier for the river reach corresponding to the input data. Used to process HAND-FIM for the location of interest.",
            "examples": [
              "8780625"
            ]
          },
          "Streamflow": {
            "type": "number",
            "minimum": 0.0,
            "title": "Streamflow",
            "description": "Streamflow value in cubic meters per second (cms) used as input for the HAND-FIM method. Determines the extent of flooding in the inundation mapping process.",
            "examples": [
              227
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "HUC",
          "ReachID",
          "Streamflow"
        ],
        "title": "Reach",
        "description": "A single streamflow estimate for a river reach within a watershed."
      },
      "Scenario": {
        "properties": {
          "ScenarioID": {
            "type": "string",
            "minLength": 1,
            "title": "Scenarioid",
            "description": "Unique identifier for the flood inundation mapping scenario. Also used to define the output file naming.",
            "examples": [
              "my-scenario",
              "scenario1",
              "scenario2"
            ]
          },
          "Reaches": {
            "items": {
              "$ref": "#/components/schemas/Reach"
            },
            "type": "array",
            "minItems": 1,
            "title": "Reaches",
            "description": "List of river reach streamflow entries belonging to this scenario."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ScenarioID",
          "Reaches"
        ],
        "title": "Scenario",
        "description": "A flood inundation mapping scenario.\n\nGroups one or more reach/streamflow entries that are combined into a\nsingle output GeoTIFF."
      },
      "SessionToken": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "user_id",
          "scope"
        ],
        "title": "SessionToken"
      },
      "StoredHandFimResult": {
        "properties": {
          "output_bucket": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Bucket"
          },
          "output_prefix": {
            "type": "string",
            "maxLength": 900,
            "title": "Output Prefix",
            "default": ""
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/HandFimOutput"
            },
            "type": "array",
            "title": "Outputs"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/OutputFile"
            },
            "type": "array",
            "title": "Files"
          },
          "local_output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Output Dir"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outputs"
        ],
        "title": "StoredHandFimResult",
        "description": "Successful outputs and the destination persisted by the worker."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "HandFimJobRequest": {
        "properties": {
          "output_bucket": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Bucket"
          },
          "output_prefix": {
            "type": "string",
            "maxLength": 900,
            "title": "Output Prefix",
            "default": ""
          },
          "max_procs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Procs",
            "description": "Max concurrent HAND-FIM processes; omit to use the worker's HAND_FIM_MAX_PROCS (default 1)."
          },
          "scenarios": {
            "$ref": "#/components/schemas/HandFimParameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenarios"
        ],
        "title": "HandFimJobRequest"
      },
      "DeviceLoginPoll": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "authorized",
              "denied",
              "failed"
            ],
            "title": "Status"
          },
          "token": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionToken"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DeviceLoginPoll"
      },
      "DeviceLoginRequest": {
        "properties": {
          "device_code": {
            "type": "string",
            "maxLength": 87,
            "minLength": 87,
            "format": "password",
            "title": "Device Code",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "device_code"
        ],
        "title": "DeviceLoginRequest"
      },
      "DeviceLoginStarted": {
        "properties": {
          "device_code": {
            "type": "string",
            "title": "Device Code"
          },
          "verification_uri": {
            "type": "string",
            "title": "Verification Uri"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "interval": {
            "type": "integer",
            "title": "Interval"
          }
        },
        "type": "object",
        "required": [
          "device_code",
          "verification_uri",
          "expires_in",
          "interval"
        ],
        "title": "DeviceLoginStarted"
      }
    },
    "securitySchemes": {
